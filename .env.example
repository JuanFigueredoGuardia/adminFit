# Configuración para Despliegue en GitHub y Netlify
# FitAdmin SaaS - Gestión de Gimnasios

# Clave de API para el Asistente FitBot AI con Gemini
GEMINI_API_KEY=""

# Configuración opcional de Firebase para Netlify / GitHub Actions
